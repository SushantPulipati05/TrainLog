<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Nothing is backed up: everything the app keeps on
     the phone (cached workouts, the sign-in, the offline queue) is either on
     the server already or tied to one phone and one account. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
