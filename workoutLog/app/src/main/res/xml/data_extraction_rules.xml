<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Nothing goes to Google Drive backups or to a new
     phone during setup: the data lives on the server and comes back on
     sign-in, and copying the sign-in or cached data between phones could
     show one account's data to another. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
