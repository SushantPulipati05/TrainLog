<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Re-arms the gym reminder after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkoutLog_AndroidStudio"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.WorkoutLog_AndroidStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps one ongoing notification showing the workout currently
             being logged (name, live timer, pause/resume) for as long as
             ActiveWorkoutState.workout is non-null, and tapping it restores
             ActiveWorkoutScreen - see ActiveWorkoutNotificationService. -->
        <service
            android:name=".ActiveWorkoutNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows an ongoing notification for the workout currently being logged" />
        </service>

        <!-- Home-screen widgets (see WorkoutHeatmapWidget.kt): Consistency,
             Up next, Up next bar and Streak. Android sends them APPWIDGET_UPDATE
             broadcasts from outside the app's own process, so these receivers
             have to be exported. -->
        <receiver
            android:name=".WorkoutHeatmapWidgetReceiver"
            android:label="@string/widget_heatmap_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/workout_heatmap_widget_info" />
        </receiver>
        <receiver
            android:name=".UpNextWidgetReceiver"
            android:label="@string/widget_up_next_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_next_widget_info" />
        </receiver>
        <receiver
            android:name=".UpNextBarWidgetReceiver"
            android:label="@string/widget_up_next_bar_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_next_bar_widget_info" />
        </receiver>
        <receiver
            android:name=".StreakWidgetReceiver"
            android:label="@string/widget_streak_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget_info" />
        </receiver>
        <!-- Gym reminders (Profile -> Training plan): fires the reminder, handles
             "Skip today", and re-schedules after a reboot, clock or time zone
             change, or an app update. Not exported - these broadcasts come from
             the app's own alarm and from the system. -->
        <receiver
            android:name=".GymReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>